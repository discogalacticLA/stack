{
  "name": "record-archive-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Local prototype: independent music archive, collection manager and simulated record marketplace (working title).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx seed/seed.ts",
    "reset": "tsx seed/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx e2e/walkthrough.ts",
    "check": "npm run typecheck && npm test",
    "fixtures:large": "tsx scripts/large-fixtures.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "playwright-core": "^1.63.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
