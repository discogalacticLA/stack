# Music Library Project (temporary name) — local configuration. No secrets are required for local use.
# Copy to .env (optional); every value below has a safe local default.

# HTTP port for the local server.
PORT=3000

# Path to the SQLite database file (created automatically).
DATABASE_PATH=./data/archive.db

# Directory for uploaded copy photos and contribution images.
UPLOAD_DIR=./data/uploads

# "development" enables the demo account switcher. Any other value disables it server-side.
NODE_ENV=development

# Set to "false" to hide the demo account switcher even in development.
DEMO_SWITCHER=true

# Minutes a checkout reservation holds a copy before it is released automatically.
RESERVATION_MINUTES=30

# Set to "true" only when served over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false

# Catalog imports (Discogs dumps) read files you pass on the command line and write NDJSON
# error logs to ./data/import-logs. No Discogs API key or account is needed or used.
